#. Description of the plugin
#: chatchi.php
msgid "Lightweight, secure live chat for WordPress with a standalone, SaaS-style agent panel."
msgstr "افزونه‌ی چت آنلاین سبک و امن برای وردپرس، با پنل اپراتور مستقل و مدرن."

#. Author of the plugin
#: chatchi.php
msgid "Taha Karami"
msgstr ""

#. translators: 1: required PHP version, 2: current PHP version.
#: chatchi.php:75
#, php-format
msgid "ChatChi requires PHP %1$s or higher. Your server is running PHP %2$s."
msgstr "چت‌چی به PHP نسخه‌ی %1$s یا بالاتر نیاز دارد. نسخه‌ی PHP سرور شما %2$s است."

#. translators: 1: required WordPress version, 2: current WordPress version.
#: chatchi.php:84
#, php-format
msgid "ChatChi requires WordPress %1$s or higher. You are running WordPress %2$s."
msgstr "چت‌چی به وردپرس نسخه‌ی %1$s یا بالاتر نیاز دارد. نسخه‌ی وردپرس شما %2$s است."

#: includes/Conversations/ConversationService.php:241
msgid "Unknown conversation status."
msgstr "وضعیت گفتگو نامعتبر است."

#: includes/Conversations/ConversationService.php:357
msgid "Conversation not found."
msgstr "گفتگو پیدا نشد."

#: includes/Conversations/ConversationService.php:365
msgid "You are not allowed to do this."
msgstr "اجازه‌ی انجام این کار را نداری."

#: includes/Conversations/ConversationService.php:381
#: includes/Visitors/VisitorService.php:115
msgid "Something went wrong. Please try again."
msgstr "مشکلی پیش آمد. لطفاً دوباره امتحان کن."

#. translators: %s: technical error message.
#: includes/Core/Activator.php:42
#, php-format
msgid "ChatChi could not be activated because its database tables could not be created: %s"
msgstr "چت‌چی فعال نشد، چون جدول‌های پایگاه داده ساخته نشدند: %s"

#: includes/Core/Activator.php:46
msgid "ChatChi activation failed"
msgstr "فعال‌سازی چت‌چی ناموفق بود"

#: includes/Core/InstallNotice.php:51
msgid "ChatChi could not set up its database tables."
msgstr "چت‌چی نتوانست جدول‌های پایگاه داده را بسازد."

#: includes/Core/InstallNotice.php:52
msgid "Chat is unavailable until this is fixed. Setup is retried automatically every few minutes."
msgstr "تا رفع این مشکل، چت در دسترس نیست. ساخت جدول‌ها هر چند دقیقه یک‌بار خودکار دوباره امتحان می‌شود."

#: includes/Visitors/ProfileValidator.php:88
msgid "Please check the highlighted fields."
msgstr "لطفاً فیلدهای مشخص‌شده را بررسی کن."

#: includes/Visitors/ProfileValidator.php:152
msgid "Please enter a valid mobile number, like 09123456789."
msgstr "یک شماره موبایل معتبر وارد کن؛ مثل ۰۹۱۲۳۴۵۶۷۸۹"

#: includes/Visitors/ProfileValidator.php:155
msgid "This field is not supported."
msgstr "این فیلد پشتیبانی نمی‌شود."

#. translators: %d: minimum number of characters.
#: includes/Visitors/ProfileValidator.php:170
#, php-format
msgid "Name must be at least %d characters."
msgstr "نام باید دست‌کم %d حرف باشد."

#. translators: %d: maximum number of characters.
#: includes/Visitors/ProfileValidator.php:178
#, php-format
msgid "Name must be at most %d characters."
msgstr "نام حداکثر می‌تواند %d حرف باشد."

#: includes/Visitors/ProfileValidator.php:193
msgid "Please enter a valid email address."
msgstr "یک ایمیل معتبر وارد کن."

#: includes/Visitors/ProfileValidator.php:205
msgid "Please enter your name."
msgstr "نامت را وارد کن."

#: includes/Visitors/ProfileValidator.php:208
msgid "Please enter your email address."
msgstr "ایمیلت را وارد کن."

#: includes/Visitors/ProfileValidator.php:211
msgid "Please enter your mobile number."
msgstr "شماره موبایلت را وارد کن."

#: includes/Visitors/ProfileValidator.php:214
msgid "This field is required."
msgstr "پر کردن این فیلد الزامی است."
