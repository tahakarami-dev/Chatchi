#: includes/Admin/PanelStrings.php:155
msgid "GapGPT"
msgstr "گپ‌جی‌پی‌تی (GapGPT)"

#: includes/Admin/PanelStrings.php:156
#: includes/Admin/PanelStrings.php:158
